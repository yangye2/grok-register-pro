TZ=Asia/Shanghai
GROK_REGISTER_PRO_PORT=8788

# Turnstile / Camoufox
TURNSTILE_BROWSER_AUTO_FETCH=1
TURNSTILE_BROWSER_TYPE=camoufox
# TURNSTILE_BROWSER_FORCE_FETCH=1
# TURNSTILE_FETCH_CHROMIUM=0
# XDG_CACHE_HOME=/data/cache
# PLAYWRIGHT_BROWSERS_PATH=/data/cache/ms-playwright

TURNSTILE_THREAD=1
# Docker: keep browser pool warm (avoid empty-pool / CAPTCHA storm)
# Local low-resource: try LAZY=1 and IDLE_SEC=30
TURNSTILE_LAZY=0
TURNSTILE_IDLE_SEC=0

# Registration proxy pool (multi-line or comma-separated)
GROK2API_XAI_PROXY_POOL=
GROK2API_XAI_PROXY_USERNAME=
GROK2API_XAI_PROXY_PASSWORD=
GROK2API_XAI_PROXY_STRATEGY=round_robin

# Optional mail defaults (can also set in admin UI)
GROK2API_MOEMAIL_API_KEY=
GROK2API_MOEMAIL_BASE_URL=
GROK2API_MOEMAIL_DOMAIN=
GROK2API_YESCAPTCHA_KEY=

# Data paths (Docker compose defaults are fine)
# GROK_REGISTER_HOST_DATA_DIR=./data/register_pro
# GROK_REGISTER_PRO_DATA_DIR=/data
# GROK_REGISTER_PRO_DB=/data/register_pro.sqlite3
# GROK_REGISTER_PRO_OUTPUT_DIR=/data/outputs

# Admin
GROK_REGISTER_ADMIN_BASE_PATH=/admin
# GROK_REGISTER_ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-strong-password
# GROK_REGISTER_ADMIN_FORCE_RESET=0
# GROK_REGISTER_ADMIN_PASSWORD_MIN_LEN=10
# COOKIE_SECURE=1
# GROK_REGISTER_ALLOW_REMOTE_SETUP=0
GROK_REGISTER_ALLOW_PRIVATE_URLS=1
# GROK_REGISTER_ALLOW_HTTP_URLS=1
# GROK_REGISTER_TRUST_X_FORWARDED_FOR=0
